# Testgram's UDP relay for 1:1 calls (source/reflector): phoneConnection with a peer_tag.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY reflector/go.mod ./
COPY reflector/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/reflector .

FROM scratch
COPY --from=build /out/reflector /reflector
EXPOSE 599/udp
USER 65534:65534
ENTRYPOINT ["/reflector"]
